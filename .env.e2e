# E2E only (AGENTS.md, "Test quality"): a production build on localhost with its own database.
# Every value here is test-only and safe to commit. Variables already set in the environment
# (CI) win over this file. DATABASE_URL is derived at run time from .env.local's, with the
# database renamed to supastarter_e2e (apps/saas/playwright.config.ts). Temporary: replace with proper environments (ADR 0016).
E2E=1
NEXT_PUBLIC_SAAS_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001
BETTER_AUTH_SECRET=e2e-only-not-a-secret-0123456789abcdef-nhip
SEND_MODE=mock
# A pretend Zalo app, so the connect flow and signed Zalo webhooks can be exercised (ADR 0017).
ZALO_APP_ID=e2e-zalo-app
ZALO_APP_SECRET=e2e-only-zalo-app-secret
ZALO_OA_SECRET_KEY=e2e-only-zalo-oa-secret
PIPE_SECRETS_KEY=ZTJlLW9ubHktbm90LWEtc2VjcmV0LTMyLWJ5dGVzISE=
# A pretend WhatsApp number (sends stay mock: SEND_MODE=mock), so a WhatsApp guest can arrive
# by a signed webhook (X-Hub-Signature-256 over the raw body with WHATSAPP_APP_SECRET).
WHATSAPP_APP_SECRET=e2e-only-whatsapp-app-secret
WHATSAPP_ACCESS_TOKEN=e2e-only-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=e2e-whatsapp-number
