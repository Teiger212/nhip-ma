{
	"name": "saas",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "next build",
		"clean": "git clean -xdf .cache .turbo dist node_modules .next .content-collections",
		"dev": "next dev --port 3010",
		"seed": "tsx --tsconfig tsconfig.json modules/inbox/scripts/seed.ts",
		"seed:check": "tsx --tsconfig tsconfig.json modules/inbox/scripts/seed-loads.ts",
		"seed:drafts": "tsx --tsconfig tsconfig.json modules/inbox/scripts/generate-demo-drafts.ts",
		"eval:drafts": "tsx --tsconfig tsconfig.json modules/inbox/scripts/eval.ts drafts",
		"eval:translation": "tsx --tsconfig tsconfig.json modules/inbox/scripts/eval.ts translation",
		"pipe:connect": "tsx --tsconfig tsconfig.json modules/inbox/scripts/connect-pipe.ts",
		"e2e": "pnpm exec playwright test --ui",
		"e2e:ci": "pnpm exec playwright install && pnpm exec playwright test",
		"e2e:changed": "E2E_REUSE=1 playwright test --only-changed=origin/main",
		"start": "next start",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"type-check": "next typegen && tsc --noEmit",
		"smoke": "playwright test --config playwright.smoke.config.ts",
		"build:vercel": "bash scripts/vercel-build.sh"
	},
	"dependencies": {
		"@ai-sdk/react": "catalog:",
		"@bprogress/next": "^3.2.12",
		"@hookform/resolvers": "catalog:",
		"@orpc/client": "catalog:",
		"@orpc/tanstack-query": "catalog:",
		"@prisma/nextjs-monorepo-workaround-plugin": "catalog:",
		"@repo/api": "workspace:*",
		"@repo/auth": "workspace:*",
		"@repo/database": "workspace:*",
		"@repo/i18n": "workspace:*",
		"@repo/mail": "workspace:*",
		"@repo/notifications": "workspace:*",
		"@repo/payments": "workspace:*",
		"@repo/permissions": "workspace:*",
		"@repo/storage": "workspace:*",
		"@repo/ui": "workspace:*",
		"@repo/utils": "workspace:*",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-table": "catalog:",
		"@teispace/next-themes": "catalog:",
		"cropperjs": "catalog:",
		"eld": "2.1.0",
		"hono": "catalog:",
		"input-otp": "catalog:",
		"js-cookie": "catalog:",
		"libphonenumber-js": "^1.13.14",
		"lucide-react": "catalog:",
		"next": "catalog:",
		"next-intl": "catalog:",
		"nprogress": "catalog:",
		"nuqs": "catalog:",
		"permix": "catalog:",
		"posthog-js": "^1.434.16",
		"posthog-node": "^5.54.1",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-dropzone": "catalog:",
		"react-hook-form": "catalog:",
		"react-qr-code": "catalog:",
		"recharts": "catalog:",
		"server-only": "catalog:",
		"sharp": "catalog:",
		"streamdown": "catalog:",
		"ufo": "catalog:",
		"usehooks-ts": "catalog:",
