		"@tailwindcss/postcss": "catalog:",
		"@types/js-cookie": "catalog:",
		"@types/node": "catalog:",
		"@types/nprogress": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/web-push": "3.6.4",
		"@vitest/coverage-v8": "catalog:",
		"better-auth": "catalog:",
