# Database
# Kit login (Better Auth) needs Postgres. Inbox threads stay in repo-root
# SQLite data/nhip.db — a postgres URL is ignored by the inbox store.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supastarter"
# Inbox-only SQLite (seed/store still honor this if you set it):
# DATABASE_URL="file:./data/nhip.db"
# ... if you use Supabase
DIRECT_URL=""

# App URLs (used for absolute URLs, sitemaps, auth callbacks, etc.)
NEXT_PUBLIC_MARKETING_URL="http://localhost:3001"
# Auth base URL and trusted origin. Must be absolute; https in production. Leave
# BETTER_AUTH_URL unset (the app sets baseURL from this value explicitly).
NEXT_PUBLIC_SAAS_URL="http://localhost:3010"
# Optional, local/tunnel only: extra origins allowed to call the auth API, comma-separated.
# AUTH_TRUSTED_ORIGINS="https://*.trycloudflare.com"

# Docs url
NEXT_PUBLIC_DOCS_URL="http://localhost:3001"

# Authentication
# Replace this value — generate one with `openssl rand -base64 32`. The app
# refuses to boot in production with this example literal, or with any
# secret shorter than 32 characters.
BETTER_AUTH_SECRET="walkthrough-better-auth-secret-key!"
# ... for Github
# Social login buttons appear only when both halves of a provider are set.
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
# ... for Google
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Mails
MAIL_FROM="noreply@example.com"
# ... with nodemailer
MAIL_HOST=""
MAIL_PORT=""
MAIL_USER=""
MAIL_PASS=""
# ... with Resend (kit auth imports Resend; a dummy value is enough for local password login)
RESEND_API_KEY="re_walkthrough"
# ... with Postmark
POSTMARK_SERVER_TOKEN=""
# ... with Mailgun
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""

# Payments
# ... with Lemonsqueezy
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""
# ... with Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# ... with Creem
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
# ... with Polar
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
# ... with DodoPayments
DODO_PAYMENTS_API_KEY=""

# Product price ids
PRICE_ID_PRO_MONTHLY="price_asdf1234"
PRICE_ID_PRO_YEARLY="price_asdf1234"
PRICE_ID_LIFETIME="price_asdf1234"

# Analytics
# ... for Pirsch
NEXT_PUBLIC_PIRSCH_CODE=""
# ... for Plausible
NEXT_PUBLIC_PLAUSIBLE_URL=""
# ... for Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=""
# ... for Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""


# Inbox send. Unset or any value other than the exact string "live" is mock.
# Never auto-send. Live WhatsApp/Zalo is not required for this walk.
SEND_MODE=mock

# WhatsApp Cloud API / Business Platform.
# Inbound webhooks are rejected (403) until WHATSAPP_APP_SECRET is set; verification fails closed.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Webhook-created threads belong to the office that owns the pipe (ADR 0008). There is no
# env for it: connect each number or OA once with
#   pnpm --filter saas pipe:connect -- --pipe whatsapp --external-id <phone_number_id> --office <organization id>
# Inbound on a pipe no office has connected is dropped.

# Zalo Official Account API.
# Inbound webhooks are rejected (403) until ZALO_OA_SECRET_KEY is set; X-ZEvent-Signature is verified.
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_SECRET_KEY=
# The OA the token belongs to. When set, a reply on a thread that arrived at any other OA
# is refused instead of going out from the wrong identity (ADR 0010).
ZALO_OA_ID=

# Draft adapter (ADRs 0005, 0007): guest message translation and AI follow-up drafts.
# Any endpoint that speaks the OpenAI chat-completions protocol. Default base URL is
# OpenRouter, which fronts every vendor with one prepaid balance (the budget). A key
# without DRAFT_MODEL is a startup error. Unset means no model: guest messages are not
# translated and every suggested reply is a template. Nothing here sends; the operator
# still approves every reply. Pick a cheap model that handles VI, JA, KO and RU, e.g. an
# OpenRouter id like google/gemini-2.5-flash-lite or deepseek/deepseek-v4-flash.
# DRAFT_API_KEY=
# DRAFT_MODEL=
# DRAFT_BASE_URL=https://openrouter.ai/api/v1

# Storage
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION=""
NEXT_PUBLIC_AVATARS_BUCKET_NAME="avatars"
# For local development with Docker Compose (MinIO):
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"

# AI
# ... with OpenAI
OPENAI_API_KEY=""
