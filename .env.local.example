# Database
# Kit login (Better Auth) needs Postgres. Inbox threads stay in repo-root
# SQLite data/nhip.db — a postgres URL is ignored by the inbox store.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supastarter"
# Inbox-only SQLite (seed/store still honor this if you set it):
# DATABASE_URL="file:./data/nhip.db"
# ... if you use Supabase
DIRECT_URL=""

# App URLs (used for absolute URLs, sitemaps, auth callbacks, etc.)
NEXT_PUBLIC_MARKETING_URL="http://localhost:3001"
NEXT_PUBLIC_SAAS_URL="http://localhost:3010"

# Docs url
NEXT_PUBLIC_DOCS_URL="http://localhost:3001"

# Authentication
BETTER_AUTH_SECRET="walkthrough-better-auth-secret-key!"
# ... for Github
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
# ... for Google
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Mails
MAIL_FROM="noreply@example.com"
# ... with nodemailer
MAIL_HOST=""
MAIL_PORT=""
MAIL_USER=""
MAIL_PASS=""
# ... with Resend (kit auth imports Resend; a dummy value is enough for local password login)
RESEND_API_KEY="re_walkthrough"
# ... with Postmark
POSTMARK_SERVER_TOKEN=""
# ... with Mailgun
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""

# Payments
# ... with Lemonsqueezy
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""
# ... with Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# ... with Creem
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
# ... with Polar
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
# ... with DodoPayments
DODO_PAYMENTS_API_KEY=""

# Product price ids
PRICE_ID_PRO_MONTHLY="price_asdf1234"
PRICE_ID_PRO_YEARLY="price_asdf1234"
PRICE_ID_LIFETIME="price_asdf1234"

# Analytics
# ... for Pirsch
NEXT_PUBLIC_PIRSCH_CODE=""
# ... for Plausible
NEXT_PUBLIC_PLAUSIBLE_URL=""
# ... for Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=""
# ... for Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""

# Showcase / Cloudflare tunnel only. Never set in production.
# When 1, unauthenticated /inbox visits redirect to GET /api/walk-bypass,
# which signs in walk@nhip.local / walkthrough via Better Auth and
# forwards the session cookie (better-auth.session_token, Path=/) to /inbox.
# WALK_BYPASS_AUTH=1

# Inbox send. Unset or any value other than the exact string "live" is mock.
# Never auto-send. Live WhatsApp/Zalo is not required for this walk.
SEND_MODE=mock

# WhatsApp Cloud API / Business Platform
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Zalo Official Account API
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_SECRET_KEY=

# Storage
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION=""
NEXT_PUBLIC_AVATARS_BUCKET_NAME="avatars"
# For local development with Docker Compose (MinIO):
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"

# AI
# ... with OpenAI
OPENAI_API_KEY=""
