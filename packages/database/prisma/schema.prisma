datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./zod"
  config   = "./zod-generator.config.json"
}

model User {
  id                       String                       @id @default(cuid())
  name                     String
  email                    String
  emailVerified            Boolean
  image                    String?
  createdAt                DateTime
  updatedAt                DateTime
  role                     String?
  banned                   Boolean?
  banReason                String?
  banExpires               DateTime?
  onboardingComplete       Boolean                      @default(false)
  paymentsCustomerId       String?
  locale                   String?
  twoFactorEnabled         Boolean?
  lastActiveOrganizationId String?
  sessions                 Session[]
  accounts                 Account[]
  passkeys                 Passkey[]
  invitations              Invitation[]
  purchases                Purchase[]
  members                  Member[]
  twofactors               TwoFactor[]
  notifications            Notification[]
  notificationPreferences  UserNotificationPreference[]
  answers                  Answer[]
  ownedConversations       Conversation[]               @relation("ConversationOwner")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  activeOrganizationId String?

  token     String
  createdAt DateTime
  updatedAt DateTime

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  accountId    String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  idToken      String?   @db.Text
  expiresAt    DateTime?
  password     String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime

  createdAt DateTime?
  updatedAt DateTime?

  @@index([identifier])
  @@map("verification")
}

/// Better Auth's rate-limit counters (rateLimit.storage "database"): shared by every
/// serverless instance, so a limit holds across them.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  verified    Boolean @default(false)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Organization {
  id                 String           @id @default(cuid())
  name               String
  slug               String?
  logo               String?
  createdAt          DateTime
  metadata           String?
  paymentsCustomerId String?
  members            Member[]
  invitations        Invitation[]
  purchases          Purchase[]
  conversations      Conversation[]
  pipeConnections    PipeConnection[]
  crmConnection      CrmConnection?
  mockCrmLeads       MockCrmLead[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum PurchaseType {
  SUBSCRIPTION
  ONE_TIME
}

model Purchase {
  id             String        @id @default(cuid())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
  type           PurchaseType
  customerId     String
  subscriptionId String?       @unique
  priceId        String
  status         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("purchase")
}

enum NotificationTarget {
  IN_APP
  EMAIL
}

enum NotificationType {
  WELCOME
  APP_UPDATE
  PIPE_DISCONNECTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  data      Json             @default("{}")
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@map("notification")
}

model UserNotificationPreference {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  target    NotificationTarget
  createdAt DateTime           @default(now())

  @@unique([userId, type, target])
  @@map("user_notification_preference")
}

// ---------------------------------------------------------------------------
// The inbox (ADR 0012): threads, messages, extraction, drafts, Answers and pipe
// connections, in the same database as the offices they belong to. Table names carry
// the inbox_ prefix so they never collide with the kit's. Closed vocabularies are
// enums; languages and rent-or-buy stay text validated by zod in packages/database/inbox.
// ---------------------------------------------------------------------------

enum Pipe {
  zalo
  whatsapp
}

enum MessageDirection {
  in
  out
}

/// `oa_echo` is the on-disk spelling of the domain's `oa-echo` (an agent replying from
/// the OA app); the store translates at its boundary.
enum MessageSource {
  guest
  oa_echo
  nhip
}

enum DraftSource {
  template
  model
}

/// The lifecycle of an Answer (ADR 0011).
enum AnswerStatus {
  sending
  sent
  failed
  unknown
}

/// One thread per guest per office (ADR 0010): the unique key is (office, pipe, guest). The id
/// is opaque (a cuid; threads from before #141 were re-keyed to UUIDs) and never names the
/// guest, because it is part of every route. `guestId` is the guest's phone or Zalo id as the
/// thread knows it; other copies (a CRM link's `leadName`, mock CRM leads, message text) are
/// guest deletion's to clear (ADR 0020, #138).
model Conversation {
  id                 String         @id
  pipe               Pipe
  guestId            String
  guestName          String?
  officeId           String
  office             Organization   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  language           String?
  lastGuestInboundAt DateTime?
  sentAt             DateTime?
  /// The agent who answered first (ADR 0015); null = in the office's pool. An owner whose
  /// account ends leaves the thread to the pool.
  ownerId            String?
  owner              User?          @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  updatedAt          DateTime
  messages           Message[]
  qualification      Qualification?
  draft              Draft?
  paperwork          Paperwork?
  answers            Answer[]
  crmLink            CrmLink?

  @@unique([officeId, pipe, guestId])
  /// What every office-owned row's foreign key points at, so a row's office is its thread's.
  @@unique([id, officeId])
  @@index([officeId, ownerId])
  @@index([ownerId])
  @@map("inbox_conversation")
}

model Message {
  id                  String               @id
  seq                 Int                  @unique @default(autoincrement())
  conversationId      String
  /// The thread's office, on every office-owned row (#95); the foreign key holds them equal.
  officeId            String
  conversation        Conversation         @relation(fields: [conversationId, officeId], references: [id, officeId], onDelete: Cascade)
  direction           MessageDirection
  source              MessageSource
  text                String
  at                  DateTime
  /// The vendor's message id as a keyed hash (HMAC-SHA256, `inbox/vendor-id.ts`), never raw:
  /// a WhatsApp id can carry the guest's number. Only the duplicate check compares it.
  vendorMessageId     String?
  mock                Boolean              @default(false)
  pipeExternalId      String?
  translations        Translation[]
  translationFailures TranslationFailure[]
  answer              Answer?
  answeringDrafts     Draft[]

  @@unique([conversationId, vendorMessageId])
  @@unique([id, officeId])
  @@index([officeId])
  @@index([conversationId])
  /// A thread's latest guest message (the list's turn and preview) and the funnel's first
  /// inbound per thread are both read by (thread, direction, time).
  @@index([conversationId, direction, at])
  @@map("inbox_message")
}

model Translation {
  messageId String
  officeId  String
  message   Message @relation(fields: [messageId, officeId], references: [id, officeId], onDelete: Cascade)
  locale    String
  text      String

  @@id([messageId, locale])
  @@index([officeId])
  @@map("inbox_translation")
}

/// A translation into one operator language that did not land (ADR 0007): the model failed
/// or answered nothing, so no Translation was stored. Kept in the database so every instance
/// waits out the same backoff instead of calling the model again on the next read. Cleared
/// when the translation lands.
model TranslationFailure {
  messageId    String
  officeId     String
  message      Message  @relation(fields: [messageId, officeId], references: [id, officeId], onDelete: Cascade)
  locale       String
  attempts     Int
  lastFailedAt DateTime

  @@id([messageId, locale])
  @@index([officeId])
  @@map("inbox_translation_failure")
}

model Qualification {
  conversationId  String       @id
  officeId        String
  conversation    Conversation @relation(fields: [conversationId, officeId], references: [id, officeId], onDelete: Cascade)
  areaOfInterest  String?
  nationality     String?
  inVietnamNow    Boolean?
  rentOrBuy       String?
  timeframe       String?
  budgetBand      String?
  bedsOrHousehold String?

  /// Prisma's one-to-one relation needs it; the primary key already makes it hold.
  @@unique([conversationId, officeId])
  @@index([officeId])
  @@map("inbox_qualification")
}

model Draft {
  conversationId   String       @id
  officeId         String
  conversation     Conversation @relation(fields: [conversationId, officeId], references: [id, officeId], onDelete: Cascade)
  reply            String
  /// The guest message this reply answers; null once that message is gone. Keyed by the
  /// message alone, not with the office like the thread: a composite key would set
  /// `officeId` null too on delete, and Prisma cannot set only one of its columns null.
  answersMessageId String?
  answersMessage   Message?     @relation(fields: [answersMessageId], references: [id], onDelete: SetNull)
  source           DraftSource  @default(template)

  /// Prisma's one-to-one relation needs it; the primary key already makes it hold.
  @@unique([conversationId, officeId])
  @@index([officeId])
  @@index([answersMessageId])
  @@map("inbox_draft")
}

model Paperwork {
  conversationId String       @id
  officeId       String
  conversation   Conversation @relation(fields: [conversationId, officeId], references: [id, officeId], onDelete: Cascade)
  mentioned      Boolean
  flag           String?

  /// Prisma's one-to-one relation needs it; the primary key already makes it hold.
  @@unique([conversationId, officeId])
  @@index([officeId])
  @@map("inbox_paperwork")
}

/// The Answer (ADR 0011): one row per answered guest message, carrying the send's whole
/// lifecycle. The operator link is set-null so the record outlives the account, and
/// `operatorName` keeps who sent it once the account is gone (ADR 0013).
model Answer {
  id              String       @id
  seq             Int          @unique @default(autoincrement())
  conversationId  String
  officeId        String
  conversation    Conversation @relation(fields: [conversationId, officeId], references: [id, officeId], onDelete: Cascade)
  inboundId       String       @unique
  inbound         Message      @relation(fields: [inboundId, officeId], references: [id, officeId], onDelete: Cascade)
  text            String
  operatorId      String?
  operator        User?        @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  operatorName    String?
  status          AnswerStatus
  mock            Boolean      @default(false)
  pipe            Pipe
  pipeExternalId  String?
  /// The sent reply's vendor id as a keyed hash, like `Message.vendorMessageId`.
  vendorMessageId String?
  approvedAt      DateTime
  sentAt          DateTime?
  failedAt        DateTime?
  failureReason   String?

  /// Prisma's one-to-one relation needs it; `inboundId` alone is already unique.
  @@unique([inboundId, officeId])
  @@index([conversationId])
  @@index([officeId])
  @@index([operatorId])
  @@map("inbox_answer")
}

/// Which office owns a pipe endpoint (ADR 0008). Webhook-created threads take this office.
model PipeConnection {
  pipe       Pipe
  externalId String
  officeId   String
  office     Organization    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  credential PipeCredential?

  @@id([pipe, externalId])
  @@index([officeId])
  @@map("inbox_pipe_connection")
}

/// A pipe endpoint's vendor tokens (Zalo OA today). Values are encrypted by the app before
/// they reach this table; a refresh rewrites the row under a row lock, because Zalo's
/// refresh token works once.
model PipeCredential {
  pipe                 Pipe
  externalId           String
  accessToken          String         @db.Text
  refreshToken         String         @db.Text
  accessTokenExpiresAt DateTime
  /// Set when the tokens stopped working (a refresh failed); the platform admin reconnects.
  disconnectedAt       DateTime?
  disconnectedReason   String?
  updatedAt            DateTime       @updatedAt
  connection           PipeConnection @relation(fields: [pipe, externalId], references: [pipe, externalId], onDelete: Cascade)

  @@id([pipe, externalId])
  @@map("inbox_pipe_credential")
}

/// One incoming webhook (ADR 0017), for "the guest says they wrote, but nothing arrived":
/// when, which pipe and endpoint, whether its signature held, what became of its messages.
/// Never message text or who the guest is. Kept 30 days.
model WebhookDelivery {
  id               String   @id @default(cuid())
  pipe             Pipe
  receivedAt       DateTime @default(now())
  /// refused (bad signature) | processed | failed (ingest threw; the vendor will retry)
  outcome          String
  /// The office endpoints (WhatsApp number ids, Zalo OA ids) its messages were addressed to.
  endpoints        String[]
  /// Offices its messages were filed to.
  officeIds        String[]
  filed            Int      @default(0)
  /// Messages to an endpoint no office holds.
  dropped          Int      @default(0)
  /// Its messages' vendor ids as keyed hashes (`inbox/vendor-id.ts`), never raw.
  vendorMessageIds String[]
  /// The error's kind when ingest failed (no message: it can carry guest data).
  errorKind        String?

  @@index([receivedAt])
  @@map("inbox_webhook_delivery")
}

enum CrmKind {
  mock
  hubspot
}

/// What the CRM says about a lead (ADR 0003). Only the CRM decides won or lost, never the chat.
enum CrmOutcomeStatus {
  open
  won
  lost
}

/// How Nhịp linked a thread to its CRM lead (ADR 0003): it created the lead, or found the
/// guest's existing lead by phone or by the Zalo user id Nhịp stored on it.
enum CrmLinkMethod {
  created
  phone
  zaloId
}

/// The office's CRM (ADR 0003). One per office; set by the platform admin.
model CrmConnection {
  officeId    String       @id
  office      Organization @relation(fields: [officeId], references: [id], onDelete: Cascade)
  kind        CrmKind
  /// The office's access token for a CRM that takes one, sealed by the app before it reaches
  /// this table (ADR 0017's encryption). Write-only: never read back to a client. Another kind
  /// replaces the row, so the token goes with it.
  accessToken String?      @db.Text
  /// The CRM's own id for the account the office is on, where one app serves many accounts and
  /// its webhooks name the account, not the office (HubSpot's portal id, #66). Null until learned
  /// from the CRM; a new access token clears it, since it may reach another account.
  accountId   String?
  links       CrmLink[]
  updatedAt   DateTime     @updatedAt

  @@index([kind, accountId])
  @@map("inbox_crm_connection")
}

/// A thread's link to its CRM lead. The row is the claim on writing the lead: whoever inserts
/// it first creates or finds the lead, so two first messages make one lead. Until the lead is
/// written, `leadId` is null. Disconnecting the office's CRM removes its links.
model CrmLink {
  conversationId    String            @id
  officeId          String
  /// Both relations carry `officeId`: the link's thread and its CRM are the same office's.
  conversation      Conversation      @relation(fields: [conversationId, officeId], references: [id, officeId], onDelete: Cascade)
  connection        CrmConnection     @relation(fields: [officeId], references: [officeId], onDelete: Cascade)
  leadId            String?
  leadName          String?
  method            CrmLinkMethod?
  claimedAt         DateTime          @default(now())
  linkedAt          DateTime?
  outcome           CrmOutcomeStatus?
  /// The CRM's own date for the outcome, for display only.
  outcomeAt         DateTime?
  outcomeReason     String?
  /// When Nhịp first saw the current won or lost outcome. A guest who writes after it is back
  /// in the queue (ADR 0003, Q3); the CRM's own date never decides that.
  outcomeObservedAt DateTime?

  /// Prisma's one-to-one relation needs it; the primary key already makes it hold.
  @@unique([conversationId, officeId])
  @@index([officeId])
  @@map("inbox_crm_link")
}

/// The mock CRM's leads (ADR 0003): a CRM kept in Nhịp's database for development, tests,
/// the demo and offices without one. Phones are E.164.
model MockCrmLead {
  id            String           @id @default(cuid())
  officeId      String
  office        Organization     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  zaloUserId    String?
  pipe          Pipe
  language      String?
  /// The guest's qualification as Nhịp extracted it (area, rent or buy, budget, timeframe,
  /// household). Never message text.
  fields        Json?
  threadUrl     String
  outcome       CrmOutcomeStatus @default(open)
  outcomeAt     DateTime?
  outcomeReason String?
  createdAt     DateTime         @default(now())

  @@index([officeId, phone])
  @@index([officeId, zaloUserId])
  @@map("inbox_mock_crm_lead")
}
