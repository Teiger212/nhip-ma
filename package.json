{
	"name": "supastarter-nextjs",
	"private": true,
	"scripts": {
		"build": "dotenv -c -- turbo build",
		"dev": "dotenv -c -- turbo dev --concurrency 15",
		"type-check": "dotenv -c -- turbo type-check",
		"start": "dotenv -c -- turbo start",
		"lint": "oxlint --deny-warnings --disable-nested-config .",
		"lint:fix": "oxlint --fix --disable-nested-config .",
		"clean": "turbo clean",
		"test": "dotenv -c -- turbo test",
		"e2e:changed": "pnpm --filter saas e2e:changed",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"seed": "dotenv -c -- pnpm --filter saas seed",
		"eval:drafts": "dotenv -c -- pnpm --filter saas eval:drafts",
		"eval:translation": "dotenv -c -- pnpm --filter saas eval:translation"
	},
	"devDependencies": {
		"@neon/config": "^1.8.2",
		"@neon/env": "^1.4.7",
		"@repo/tsconfig": "workspace:*",
		"@shadcn/lint": "0.2.0",
		"@types/node": "catalog:",
		"dotenv-cli": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "^7.0.2001",
		"turbo": "^2.10.10",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.3.0"
}
