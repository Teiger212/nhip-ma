{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "react", "import", "jsx-a11y", "oxc"],
	"ignorePatterns": ["**/.content-collections/**", "**/prisma/zod/index.ts", "**/.claude/**"],
	"options": {
		"typeAware": true
	},
	"jsPlugins": ["@shadcn/lint", "./tooling/oxlint/nhip.mjs"],
	"rules": {
		"nhip/background-label-is-literal": "error",
		"nhip/no-native-select": "error",
		"react/set-state-in-effect": "off",
		"react/purity": "off",
		"react/immutability": "off",
		"react/preserve-manual-memoization": "off",
		"react/incompatible-library": "off",
		"shadcn/no-raw-colors": "error",
		"shadcn/no-arbitrary-values": "error",
		"shadcn/no-inline-styles": "error",
		"shadcn/no-unknown-classes": "error",
		"shadcn/no-restyle": [
			"error",
			{
				"allow": ["layout"],
				"contracts": [
					{
						"pattern": "^Card(Header|Content)?$",
						"allow": ["layout", "spacing"]
					},
					{
						"pattern": "^Skeleton$",
						"allow": ["layout", "shape"]
					},
					{
						"pattern": "^Input$",
						"allow": ["layout", "pr-*"]
					}
				]
			}
		],
		"shadcn/require-static-classes": "error"
	},
	"overrides": [
		{
			"files": [
				"apps/marketing/**",
				"apps/docs/**",
				"apps/mail-preview/**",
				"packages/mail/**",
				"packages/ui/**",
				"apps/saas/modules/ai/**",
				"apps/saas/modules/payments/**"
			],
			"rules": {
				"shadcn/no-raw-colors": "off",
				"shadcn/no-arbitrary-values": "off",
				"shadcn/no-inline-styles": "off",
				"shadcn/no-unknown-classes": "off",
				"shadcn/no-restyle": "off",
				"shadcn/require-static-classes": "off"
			}
		},
		{
			"files": ["packages/ui/**"],
			"rules": {
				"nhip/no-native-select": "off"
			}
		},
		{
			"files": [
				"apps/saas/modules/auth/components/OtpForm.tsx",
				"apps/saas/modules/onboarding/components/OnboardingAccountStep.tsx",
				"apps/saas/modules/organizations/components/OrganizationLogo.tsx",
				"apps/saas/modules/organizations/components/OrganizationLogoForm.tsx",
				"apps/saas/modules/organizations/components/OrganizationSelect.tsx",
				"apps/saas/modules/organizations/components/OrganizationsGrid.tsx",
				"apps/saas/modules/settings/components/UserAvatarUpload.tsx",
				"apps/saas/modules/shared/components/UserAvatar.tsx"
			],
			"rules": {
				"shadcn/no-restyle": "off",
				"shadcn/require-static-classes": "off"
			}
		}
	],
	"settings": {
		"shadcn": {
			"ui": "@repo/ui"
		}
	}
}
