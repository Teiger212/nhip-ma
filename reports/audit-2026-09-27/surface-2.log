   120		guestName?: string | null;
   121		vendorMessageId?: string | null;
   122		at?: number | string | Date;
   123	}): Promise<Conversation> {
   124		const runtime = getRuntime();
   125		const conv = await runtime.store.upsertInbound(
   126			{
   127				pipe: input.pipe,
   128				guestId: input.guestId,
   129				guestName: input.guestName || null,
   130				text: input.text,
   131				vendorMessageId: input.vendorMessageId || null,
   132				at: input.at || Date.now(),
   133				source: "guest",
   134			},
   135			input.officeId,
   136		);
   137		return afterGuestInbound(runtime, conv);
   138	}
