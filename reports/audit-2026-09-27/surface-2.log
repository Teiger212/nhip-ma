   209	export async function approveAndSend(
   210		id: string,
   211		input: ApproveInput,
   212		viewer?: InboxViewer,
   213	): Promise<InboxResult> {
   214		const { store, config } = getRuntime();
   215		const conv = await store.getConversation(id, viewer);
   216		if (!conv) {
   217			return { ok: false, status: 404, error: "not_found" };
   218		}
   219		const inboundId = conv.unansweredInboundId;
   220		if (!inboundId) {
   221			// Nothing open. If that is because a send's outcome is unknown, say so: the operator
   222			// has something to check, not a guest who has been answered.
   223			return hasUnknownAnswer(conv) ? DELIVERY_UNKNOWN : ALREADY_ANSWERED;
   224		}
   225		if (!input.inboundId) {
   226			return {
   227				ok: false,
   228				status: 400,
   229				error: "inbound_required",
   230				message: "An approval must name the guest message it answers.",
   231			};
   232		}
   233		if (input.inboundId !== inboundId) {
   234			return {
   235				ok: false,
   236				status: 409,
   237				error: "stale_target",
   238				message: "The guest wrote again since this reply was drafted. Review the new message.",
   239			};
   240		}
   241		const text = input.text?.trim();
   242		if (!text) {
   243			return {
   244				ok: false,
   245				status: 400,
   246				error: "empty_reply",
   247				message: "The reply is empty. Nothing was sent.",
   248			};
   249		}
   250	
   251		const adapter = pipeAdapter(conv.pipe);
   252		const window = adapter.sendWindow(conv);
   253		if (!window.open) {
   254			return {
   255				ok: false,
   256				status: 409,
   257				error: window.reason,
   258				message: window.message,
   259			};
   260		}
   261	
   262		// The reply goes out on the number the guest wrote to (ADR 0010). With process-wide
   263		// credentials, a thread that arrived on any other number cannot be answered from here.
   264		const endpoint = latestGuestEndpoint(conv);
   265		if (config.sendMode === "live" && endpoint && !adapter.ownsEndpoint(endpoint, config)) {
   266			return {
   267				ok: false,
   268				status: 409,
   269				error: "pipe_not_configured",
   270				message:
   271					"This thread arrived on a number or OA this deployment is not configured to send from.",
   272			};
   273		}
   274	
   275		// The Answer is written before the vendor call. Its unique inbound is the guard against
   276		// a concurrent approval; its status is what decides whether a retry is ever allowed.
   277		const begun = await store.beginAnswer({
   278			conversationId: conv.id,
   279			inboundId,
   280			text,
   281			operatorId: viewer?.userId ?? null,
   282		});
