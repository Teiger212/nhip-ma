   155							nationality: record.qualification.nationality,
   156							inVietnamNow: record.qualification.inVietnamNow,
   157							rentOrBuy: vocab(
   158								RentOrBuy.nullable(),
   159								record.qualification.rentOrBuy,
   160								"Qualification.rentOrBuy",
   161							),
   162							timeframe: record.qualification.timeframe,
   163							budgetBand: record.qualification.budgetBand,
   164							bedsOrHousehold: record.qualification.bedsOrHousehold,
   165						},
   166						paperwork: { mentioned: record.paperwork.mentioned, flag: record.paperwork.flag },
   167						draft: {
