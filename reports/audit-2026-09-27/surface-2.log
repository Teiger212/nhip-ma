    38	export function createOpenAiCompatibleDraftAdapter(input: {
    39		apiKey: string;
    40		baseUrl: string;
    41		model: string;
    42	}): DraftAdapter {
    43		const endpoint = `${input.baseUrl.replace(/\/+$/, "")}/chat/completions`;
    44	
    45		// Guest text never reaches the log; only what the endpoint said about the request.
    46		function warn(detail: Record<string, unknown>): null {
    47			console.warn("inbox draft adapter: request failed", { model: input.model, ...detail });
    48			return null;
    49		}
    50	
    51		async function complete(system: string, user: string, maxTokens: number): Promise<string | null> {
    52			try {
    53				const response = await fetch(endpoint, {
    54					method: "POST",
    55					headers: {
    56						"Content-Type": "application/json",
    57						Authorization: `Bearer ${input.apiKey}`,
    58					},
    59					body: JSON.stringify({
    60						model: input.model,
    61						max_tokens: maxTokens,
    62						temperature: 0.2,
    63						messages: [
    64							{ role: "system", content: system },
    65							{ role: "user", content: user },
    66						],
    67					}),
    68					signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
    69				});
    70				if (!response.ok) {
    71					return warn({ status: response.status });
    72				}
