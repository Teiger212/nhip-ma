   284			switch (begun.reason) {
   285				case "already_answered":
   286					return ALREADY_ANSWERED;
   287				case "in_progress":
   288					return {
   289						ok: false,
   290						status: 409,
   291						error: "send_in_progress",
   292						message: "This message is being sent by another approval.",
   293					};
   294				case "unknown":
   295					return DELIVERY_UNKNOWN;
   296			}
   297		}
   298		const answerId = begun.answer.id;
   299	
   300		let result: SendResult;
   301		try {
   302			result = await transmit({ conversation: conv, text, config });
   303		} catch (err) {
   304			const message = err instanceof Error ? err.message : "send failed";
   305			if (err instanceof SendError) {
   306				// The vendor refused, or nothing was sent: a definite failure the operator may retry.
   307				await store.failAnswer(answerId, message);
   308				return { ok: false, status: 502, error: "send_failed", message, detail: err.detail };
   309			}
   310			// A network failure or timeout: the vendor may or may not have the message. Never
   311			// retried automatically, and never approved again until a person has checked.
   312			await store.markAnswerUnknown(answerId, message);
   313			return {
   314				ok: false,
   315				status: 502,
   316				error: "delivery_unknown",
   317				message: `${DELIVERY_UNKNOWN_MESSAGE} (${message})`,
   318			};
   319		}
   320	
   321		try {
   322			const updated = await store.completeAnswer(answerId, result);
   323			if (!updated) {
   324				return { ok: false, status: 404, error: "not_found" };
   325			}
   326			return { ok: true, conversation: updated };
