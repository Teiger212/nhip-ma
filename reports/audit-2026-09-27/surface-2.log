   341	/**
   342	 * The operator asks for a new suggestion (ADR 0005). This is the one place a first reply
   343	 * goes to the model: the automatic path keeps the template, an explicit request does not.
   344	 * Without a model, or when the model's draft fails the post-check, the template is put
   345	 * back so the box is never empty.
   346	 */
   347	export async function regenerateDraft(id: string, viewer?: InboxViewer): Promise<InboxResult> {
   348		const runtime = getRuntime();
   349		const conv = await runtime.store.getConversation(id, viewer);
   350		if (!conv) {
   351			return { ok: false, status: 404, error: "not_found" };
   352		}
   353		if (!conv.unansweredInboundId) {
   354			return ALREADY_ANSWERED;
   355		}
   356		if (!conv.oneShot) {
   357			return { ok: false, status: 400, error: "no_draft" };
   358		}
   359		const drafted = await generateModelDraft(runtime, conv);
   360		if (drafted) {
   361			return { ok: true, conversation: drafted };
   362		}
   363		const shot = conv.oneShot;
   364		const reply = conv.sentAt
   365			? followUpTemplate(shot.language)
   366			: draftReply(shot.language, shot.qualification);
