   266							await tx.conversation.update({
   267								where: { id: threadId },
   268								data: { guestName: existing.guestName ?? (event.guestName || null), updatedAt: at },
   269							});
   270						} else {
   271							await tx.conversation.create({
   272								data: {
   273									id: threadId,
   274									pipe: event.pipe,
   275									guestId: event.guestId,
   276									guestName: event.guestName || null,
