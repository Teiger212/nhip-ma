    74				if (!parsed.success) {
    75					return warn({ status: response.status, reason: "unexpected response shape" });
    76				}
    77				const [choice] = parsed.data.choices;
    78				if (choice.finish_reason === "content_filter") {
    79					return null;
    80				}
    81				const text = choice.message.content?.trim();
    82				return text || null;
    83			} catch (error) {
    84				return warn({ reason: error instanceof Error ? error.message : String(error) });
    85			}
    86		}
    87	
    88		return {
    89			provider: "openai-compatible",
    90			translate: (request) =>
    91				complete(
    92					translationSystemPrompt(request.to),
    93					translationUserPrompt(request),
    94					TRANSLATION_MAX_TOKENS,
    95				),
    96			followUp: (request) =>
    97				complete(
    98					followUpSystemPrompt(request.guestLanguage),
    99					followUpUserPrompt(request),
   100					FOLLOW_UP_MAX_TOKENS,
   101				),
   102		};
   103	}

