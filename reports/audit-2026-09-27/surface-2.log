   233			async listConversations(viewer?: InboxViewer) {
   234				const records = await db.conversation.findMany({
   235					where: viewer ? { officeId: viewer.officeId } : undefined,
   236					orderBy: { updatedAt: "desc" },
   237					include: CONVERSATION_INCLUDE,
   238				});
