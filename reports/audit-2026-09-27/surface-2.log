    92	 * Webhook events are filed under the office that owns the pipe they arrived on
    93	 * (ADR 0008). An event from a pipe no office has connected is dropped, not filed under
    94	 * nobody: tenancy fails closed, and the log says which pipe to connect.
    95	 */
    96	export async function ingestEvents(runtime: Runtime, events: InboundEvent[]): Promise<void> {
    97		for (const event of events) {
    98			const officeId = event.pipeExternalId
    99				? await runtime.store.officeForPipe(event.pipe, event.pipeExternalId)
   100				: null;
   101			if (!officeId) {
   102				console.warn("inbox: inbound dropped, no office owns this pipe", {
   103					pipe: event.pipe,
   104					pipeExternalId: event.pipeExternalId ?? null,
   105				});
   106				continue;
   107			}
   108			const conv = await runtime.store.upsertInbound(event, officeId);
   109			if (event.source === "guest") {
   110				await afterGuestInbound(runtime, conv);
   111			}
   112		}
   113	}
