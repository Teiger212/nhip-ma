    29	export function nowIso(at?: number | string | Date): string {
    30		if (at instanceof Date) {
    31			return at.toISOString();
    32		}
    33		if (typeof at === "number") {
    34			return new Date(at).toISOString();
    35		}
    36		if (typeof at === "string" && at) {
    37			return new Date(at).toISOString();
