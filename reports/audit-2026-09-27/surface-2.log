   543			async funnel(viewer, window) {
   544				const since = new Date(nowIso(window.since));
   545				const until = new Date();
   546				// One row per cohort lead, never per message; the percentiles are the only thing
   547				// left for JavaScript.
   548				const leads = await db.$queryRaw<
   549					Array<{ firstInboundAt: Date; firstSentAt: Date | null; wroteBack: boolean }>
   550				>`
   551					WITH "first" AS (
   552						SELECT "conversationId", MIN("at") AS "firstInboundAt"
   553						FROM "inbox_message" WHERE "direction" = 'in' GROUP BY "conversationId"
   554					),
   555					"reached" AS (
   556						SELECT "conversationId", MIN("at") AS "firstSentAt" FROM (
   557							SELECT "conversationId", "sentAt" AS "at" FROM "inbox_answer"
   558							WHERE "status" = 'sent' AND (${window.countMock} OR NOT "mock")
   559							UNION ALL
   560							SELECT "conversationId", "at" FROM "inbox_message"
   561							WHERE "direction" = 'out' AND "source" = 'oa_echo'
   562						) "replies" GROUP BY "conversationId"
   563					)
   564					SELECT "first"."firstInboundAt" AS "firstInboundAt",
   565					       "reached"."firstSentAt" AS "firstSentAt",
   566					       EXISTS (
   567					         SELECT 1 FROM "inbox_message" "later"
   568					         WHERE "later"."conversationId" = "c"."id"
   569					           AND "later"."direction" = 'in'
   570					           AND "later"."at" > "reached"."firstSentAt"
   571					       ) AS "wroteBack"
   572					FROM "inbox_conversation" "c"
   573					JOIN "first" ON "first"."conversationId" = "c"."id"
   574					LEFT JOIN "reached" ON "reached"."conversationId" = "c"."id"
   575					WHERE "c"."officeId" = ${viewer.officeId} AND "first"."firstInboundAt" >= ${since}
   576				`;
   577				const durations = leads
   578					.flatMap((lead) =>
   579						lead.firstSentAt ? [lead.firstSentAt.getTime() - lead.firstInboundAt.getTime()] : [],
   580					)
   581					.map((ms) => Math.max(0, ms))
   582					.sort((a, b) => a - b);
   583				const funnel: Funnel = {
   584					since: iso(since),
   585					until: iso(until),
   586					leadsIn: leads.length,
   587					engaged: durations.length,
   588					inConversation: leads.filter((lead) => lead.firstSentAt && lead.wroteBack).length,
   589					responseTime:
   590						durations.length === 0
   591							? null
   592							: {
   593									answered: durations.length,
   594									medianMs: nearestRank(durations, 0.5),
   595									p90Ms: nearestRank(durations, 0.9),
   596								},
   597				};
   598				return funnel;
   599			},
