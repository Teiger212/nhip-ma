   328			// The vendor accepted but the record failed. The Answer stays on file as unknown, so
   329			// the reply is not sent a second time; someone reconciles it against the vendor.
   330			const message = err instanceof Error ? err.message : "record failed";
   331			await store.markAnswerUnknown(answerId, `recorded_failed: ${message}`).catch(() => undefined);
   332			return {
   333				ok: false,
   334				status: 500,
   335				error: "record_failed",
   336				message: "The reply was sent but could not be recorded. It will not be sent again.",
   337			};
   338		}
   339	}
