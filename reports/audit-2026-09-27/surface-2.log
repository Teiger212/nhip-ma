    42	/**
    43	 * One thread per guest per office (ADR 0010). The office is part of the identity, so the
    44	 * same guest writing to two offices is two threads that never see each other. The id is
    45	 * part of every route, so it keeps this shape; the unique key is the triple.
    46	 */
    47	export function conversationId(officeId: string, pipe: string, guestId: string): string {
