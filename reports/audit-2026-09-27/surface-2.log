    51	/** Everything a `Conversation` is built from, in one read. */
    52	const CONVERSATION_INCLUDE = {
    53		messages: { orderBy: [{ at: "asc" }, { seq: "asc" }], include: { translations: true } },
    54		qualification: true,
    55		draft: true,
    56		paperwork: true,
    57		answers: { orderBy: [{ approvedAt: "asc" }, { seq: "asc" }] },
